<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ESPApp.UI.ViewModels"
        xmlns:views="using:ESPApp.UI.Views"
        x:Class="ESPApp.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="ESP Tool GUI Edition"
        Width="1120" Height="820"
        MinWidth="900" MinHeight="640"
        FontFamily="Segoe UI, Roboto, Helvetica Neue, Arial, sans-serif"
        FontSize="14"
        Background="{StaticResource BrushBgMain}"
        Foreground="{StaticResource BrushTextMain}"
        WindowStartupLocation="CenterScreen">

    <Window.DataTemplates>
        <DataTemplate DataType="{x:Type vm:FirmwarePageViewModel}">
            <views:FirmwarePage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MemoryPageViewModel}">
            <views:MemoryPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ChipInfoPageViewModel}">
            <views:ChipInfoPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ToolsPageViewModel}">
            <views:ToolsPage/>
        </DataTemplate>
    </Window.DataTemplates>

    <Window.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource BrushBgCard}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
        <Style Selector="Border.connection-panel">
            <Setter Property="Background" Value="{StaticResource BrushBgCard}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style Selector="Border.sidebar">
            <Setter Property="Background" Value="{StaticResource BrushBgCard}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>
        <Style Selector="Border.terminal">
            <Setter Property="Background" Value="{StaticResource BrushBgTerminal}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>
        <Style Selector="Expander">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="ScrollViewer">
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="CornerRadius" Value="2"/>
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{StaticResource BrushAccent}"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#3b82f6"/>
            <Setter Property="TextElement.Foreground" Value="#ffffff"/>
        </Style>
        <Style Selector="ToggleButton.sidebar-item">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextMain}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="ToggleButton.sidebar-item:pointerover">
            <Setter Property="Background" Value="#2d2d2d"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
        </Style>
        <Style Selector="ToggleButton.sidebar-item:checked">
            <Setter Property="Background" Value="#303030"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="Foreground" Value="#ffffff"/>
        </Style>
    </Window.Styles>

    <Panel>
        <Grid ColumnDefinitions="190,*">
            <!-- Left navigation -->
            <Border Grid.Column="0" Classes="sidebar">
                <Grid RowDefinitions="*,Auto">
                    <ItemsControl Grid.Row="0" ItemsSource="{Binding NavigationPages}"
                                  IsEnabled="{Binding !Execution.IsBusy}" Margin="8,14,8,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" Spacing="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PageViewModelBase">
                                <ToggleButton Classes="sidebar-item"
                                              IsChecked="{Binding IsSelected, Mode=OneWay}"
                                              Command="{Binding NavigateCommand}">
                                    <Grid ColumnDefinitions="3,*" ColumnSpacing="10" MinHeight="38">
                                        <Border Grid.Column="0" Background="{StaticResource BrushAccent}"
                                                IsVisible="{Binding IsSelected}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}"
                                                   VerticalAlignment="Center" Margin="10,0,8,0"/>
                                    </Grid>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Grid.Row="1" Content="⚙" ToolTip.Tip="Выбор esptool и настройки"
                            HorizontalAlignment="Stretch" Margin="12"
                            Command="{Binding ShowWelcomeCommand}"/>
                </Grid>
            </Border>

            <!-- Main workspace -->
            <Grid Grid.Column="1" Margin="18" RowDefinitions="Auto,*,Auto,190" RowSpacing="10">
                <Border Grid.Row="0" Classes="connection-panel">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" ColumnSpacing="10">
                            <TextBlock Grid.Column="0" Classes="muted" Text="Порт"/>
                            <DockPanel Grid.Column="1">
                                <Button DockPanel.Dock="Right" Content="↻" Margin="6,0,0,0"
                                        Command="{Binding Connection.RefreshPortsCommand}"/>
                                <ComboBox ItemsSource="{Binding Connection.AvailablePorts}"
                                          SelectedItem="{Binding Connection.SelectedPort}"/>
                            </DockPanel>
                            <TextBlock Grid.Column="2" Classes="muted" Text="Чип"/>
                            <ComboBox Grid.Column="3" ItemsSource="{Binding Connection.Chips}"
                                      SelectedItem="{Binding Connection.SelectedChip}"/>
                            <TextBlock Grid.Column="4" Classes="muted" Text="Скорость"/>
                            <ComboBox Grid.Column="5" ItemsSource="{Binding Connection.Bauds}"
                                      SelectedItem="{Binding Connection.SelectedBaud}"/>
                        </Grid>

                        <Expander Header="Дополнительно" Padding="0,2,0,0">
                            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,70" RowDefinitions="Auto,Auto"
                                  ColumnSpacing="10" RowSpacing="8" Margin="0,8,0,0">
                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="muted" Text="До"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Connection.BeforeModes}"
                                          SelectedItem="{Binding Connection.SelectedBefore}"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Classes="muted" Text="После"/>
                                <ComboBox Grid.Row="0" Grid.Column="3" ItemsSource="{Binding Connection.AfterModes}"
                                          SelectedItem="{Binding Connection.SelectedAfter}"/>
                                <TextBlock Grid.Row="0" Grid.Column="4" Classes="muted" Text="Попыток"/>
                                <TextBox Grid.Row="0" Grid.Column="5" Text="{Binding Connection.ConnectAttempts}"
                                         HorizontalContentAlignment="Center"/>
                                <WrapPanel Grid.Row="1" Grid.ColumnSpan="6">
                                    <CheckBox Content="Без стаба" IsChecked="{Binding Connection.NoStub}"/>
                                    <CheckBox Content="Подробный вывод" IsChecked="{Binding Connection.Trace}"/>
                                </WrapPanel>
                            </Grid>
                        </Expander>
                    </StackPanel>
                </Border>

                <ContentControl Grid.Row="1" x:Name="PageFrame" Content="{Binding CurrentPage}"/>

                <ProgressBar Grid.Row="2" IsIndeterminate="True"
                             IsVisible="{Binding Execution.IsBusy}" Height="3"/>

                <Border Grid.Row="3" Classes="terminal" MinHeight="150">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="2,0,0,6">
                            <Button DockPanel.Dock="Right" Content="Очистить" FontSize="12" Padding="10,2"
                                    Command="{Binding Execution.ClearLogCommand}"/>
                            <Button DockPanel.Dock="Right" Content="Остановить" FontSize="12" Padding="10,2"
                                    Margin="0,0,8,0" IsVisible="{Binding Execution.IsBusy}"
                                    Command="{Binding Execution.CancelCommand}"/>
                            <TextBlock Classes="muted" Text="Лог" FontSize="12"/>
                        </DockPanel>
                        <TextBox Text="{Binding Execution.ConsoleOutput}"
                                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                 HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                 Background="Transparent" Foreground="#e0e0e0" BorderThickness="0"
                                 FontFamily="Consolas, Menlo, monospace" FontSize="12"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- The original first-run setup screen -->
        <Border IsVisible="{Binding IsWelcomeVisible}" Background="#CC000000">
            <views:WelcomeView DataContext="{Binding Welcome}"/>
        </Border>
    </Panel>
</Window>
